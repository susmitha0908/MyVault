# ==========================================
# VAULTOPS CONFIGURATION (DEVELOPMENT)
# ==========================================

# Application Environment
APP_ENV=development
SECRET_KEY=dev_placeholder_only_replace_in_prod_minimum_32_bytes_long_string_abc123
ACCESS_TOKEN_EXPIRE_MINUTES=30
VAULT_LOCK_TIMEOUT_MINUTES=15

# Database Setup (PostgreSQL)
POSTGRES_USER=vaultops_admin
POSTGRES_PASSWORD=dev_db_secure_password_replace_me
POSTGRES_DB=vaultops_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql://vaultops_admin:dev_db_secure_password_replace_me@postgres:5432/vaultops_db

# Local Port Mappings
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security: Master KEK (For Envelope Encryption Local Simulation)
# A 32-byte key base64-encoded. Used only if AWS_KMS_KEY_ID is not provided.
# Generate via: openssl rand -base64 32
LOCAL_MASTER_KEK=eDRkd2V5c2ZkZ3NkaGZnaHdhZXJ0eXVpb3A4NzY1NDM=

# AWS Integration (For Production - Leave empty in development to trigger mocks)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=
AWS_KMS_KEY_ID=

# Storage Path (For local S3-mock storage simulation)
LOCAL_STORAGE_DIR=/app/storage
